# Copy to `.env` and fill in. Every variable is optional for local play (SQLite + scripted NPC fallback).
# --- core ---------------------------------------------------------------
RAAZ_ENV=dev                         # dev | test | prod
RAAZ_DATABASE_URL=sqlite:///./raaz.db
# PostgreSQL (docker compose / production):
# RAAZ_DATABASE_URL=postgresql+psycopg://raaz:CHANGE_ME@db:5432/raaz
RAAZ_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_BYTES
RAAZ_CORS_ORIGINS=http://localhost:5173
RAAZ_ALLOW_GUEST=true
# RAAZ_REDIS_URL=redis://redis:6379/0   # optional: shared rate limiting
# RAAZ_METRICS_TOKEN=CHANGE_ME           # if set, /metrics requires header X-Metrics-Token

# --- LLM provider for NPC dialogue & Nazar phrasing (optional) -----------
# With none configured the game uses clearly-labelled scripted dialogue.
RAAZ_LLM_PROVIDER=none               # none | anthropic | openai
# RAAZ_ANTHROPIC_API_KEY=
# RAAZ_ANTHROPIC_MODEL=claude-sonnet-5-5
# RAAZ_OPENAI_API_KEY=
# RAAZ_OPENAI_BASE_URL=               # any OpenAI-compatible server (e.g. a local one)
# RAAZ_OPENAI_MODEL=gpt-4o-mini
RAAZ_LLM_TIMEOUT_S=20
RAAZ_CONVERSATION_TOKEN_BUDGET=40000
# Optional *estimated* cost tracking (USD per 1k tokens) — leave 0 to disable
RAAZ_LLM_COST_PER_1K_IN_USD=0
RAAZ_LLM_COST_PER_1K_OUT_USD=0

# --- limits ---------------------------------------------------------------
RAAZ_RATE_LIMIT_PER_MIN=240
RAAZ_LLM_RATE_LIMIT_PER_MIN=30
RAAZ_AGENT_RUNS_PER_HOUR=20

# --- ML -------------------------------------------------------------------
RAAZ_ARTIFACTS_DIR=./artifacts
# RAAZ_MLFLOW_TRACKING_URI=http://mlflow:5000   # optional mirror of experiment tracking (requires `pip install mlflow`)
# Developer ML workbench: on by default in dev, OFF in prod unless you set this to true.
# RAAZ_ML_WORKBENCH_ENABLED=true

# --- docker compose only --------------------------------------------------
POSTGRES_USER=raaz
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=raaz
